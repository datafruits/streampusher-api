<div class="modal-body m-1">
  <form data-on:submit="@post('/login', {filterSignals: {include: /^user\./}})">
    <p class="mt-2 mb-2">
      <%= t "chat.login_why" %>
    </p>
    <div>
      <input
        type="text"
        name="username"
        autocomplete="username"
        data-bind="user.login"
        autocorrect="off"
        autocapitalize="none"
        placeholder="<%= t "chat.username" %>"
        data-test-username
      />
      <input
        type="password"
        name="pass"
        autocomplete="current-password"
        data-bind="user.password"
        autocorrect="off"
        autocapitalize="none"
        placeholder="<%= t "chat.password" %>"
        data-test-password
      />
    </div>
    <div>
      <button
        type="submit"
        class="cool-button mt-2"
        data-test-login-submit
      >
        <%= t "chat.login" %>
      </button>
    </div>

    <div class="flex items-center justify-between mt-3">
      <%= link_to t("chat.forgot_password"), new_user_password_path %>
      <div class="relative">
        <%= link_to t("chat.sign_up"), sign_up_path %>
      </div>
    </div>
  </form>
</div>
