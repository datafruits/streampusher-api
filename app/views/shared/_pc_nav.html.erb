<nav id="desktop-navbar" class="classic:bg-df-pink blm:bg-black trans:bg-df-blue mb-2 hidden md:block overflow-hidden w-full text-3xl relative" role="navigation">
    <ul class="flex flex-wrap mt-2 ml-2">
     <li class="its-just-a-website-menu-item">
       <a href="#radio"
          data-on:mouseover__debounce.500ms="$submenuOpen = !$submenuOpen"
          aria-label="<%= t('.radio.aria', default: 'Radio') %>"
          class="text-white text-shadow-light hover:text-white">
          <%= t('.radio.title', default: 'Radio') %>
          <svg class="transition-all duration-100 ease-in-out inline w-6 h-6"
               data-class:rotate-90="$submenuOpen == true"
               aria-hidden="true"
               fill="none"
               stroke="currentColor"
               viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
       </a>
     </li>
    <li class="its-just-a-website-menu-item">
      <%= link_to t("chat.title"), chat_path, class: "text-white text-shadow-light hover:text-gray-400" %>
    </li>
    <li class="its-just-a-website-menu-item">
