  <!-- Settings Dialog - handled by <ui-modal> web component, toggled via $settingsModalOpen -->

  <%= render 'shared/nav_auth' %>

<!-- ui-modal teleports itself into #modals-container (see app/javascript/components/ui-modal.js) -->
<ui-modal
   data-class:hidden="$settingsModalOpen == false"
   data-on:ui-modal:close="$settingsModalOpen = false"
>
  <%= render 'shared/website_settings' %>
</ui-modal>
<ui-modal
   data-class:hidden="$loginModalOpen == false"
   data-on:ui-modal:close="$loginModalOpen = false"
>
  <%= render 'shared/login_modal' %>
</ui-modal>
