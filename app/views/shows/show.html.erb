<section class="page-spacing">
  <%= link_to '← All shows', shows_path %>
  <div class="flex flex-col md:flex-row gap-6 mt-4">
    <div class="w-full md:w-1/2 page-bg p-4">
      <% if @show.as_image.attached? %>
        <%= image_tag @show.as_image, alt: '', class: 'w-full rounded-lg', loading: 'lazy' %>
      <% end %>
      <h1 class="text-3xl"><%= @show.title %></h1>
      <% if @show.archived? %><p>Archived show</p><% end %>
      <p><%= show_schedule(@show) %></p>
      <%= render 'shows/hosts', hosts: @show.users %>
      <div class="wiki-article break-words"><%= render_wiki_markdown(@show.description) %></div>
      <%= render 'shows/labels', labels: @show.labels %>
    </div>
    <div class="w-full md:w-1/2">
      <h2 class="text-2xl mb-3">Episodes</h2>
      <% @episodes.each do |episode| %>
        <article class="page-bg rounded-lg p-4 mb-3">
          <h3 class="text-xl"><%= link_to episode.title, show_episode_path(@show.slug, episode.slug) %></h3>
          <time datetime="<%= episode.start_at.iso8601 %>"><%= episode.start_at.in_time_zone.strftime('%B %-d, %Y · %H:%M %Z') %></time>
          <%= render 'shows/hosts', hosts: episode.performers %>
          <%= render 'shows/labels', labels: episode.labels %>
        </article>
      <% end %>
      <% if @episodes.empty? %><p>No published episodes yet.</p><% end %>
      <%= render 'shows/pagination', collection: @episodes, base_path: show_path(@show.slug), query: nil %>
    </div>
  </div>
</section>
