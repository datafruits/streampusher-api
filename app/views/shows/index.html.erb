<section class="page-spacing">
  <h1 class="debussy-header">Shows</h1>
  <form action="<%= shows_path %>" method="get" class="flex flex-wrap gap-3 mb-4">
    <label>Search shows <input type="search" name="query" value="<%= @query %>" class="bg-white text-black p-2"></label>
    <button type="submit" class="cool-button">Search</button>
    <%= link_to 'All shows', shows_path %>
  </form>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    <% @shows.each do |show| %>
      <article class="page-bg rounded-lg p-4">
        <% if show.as_image.attached? %>
          <%= image_tag show.as_image, alt: '', class: 'w-full h-48 object-cover rounded-lg', loading: 'lazy' %>
        <% end %>
        <h2 class="text-2xl"><%= link_to show.title, show_path(show.slug) %></h2>
        <% if show.archived? %><p>Archived show</p><% end %>
        <p><%= show_schedule(show) %></p>
        <%= render 'shows/hosts', hosts: show.users %>
        <%= render 'shows/labels', labels: show.labels %>
      </article>
    <% end %>
  </div>
  <% if @shows.empty? %><p>No shows found. Try another title.</p><% end %>
  <%= render 'shows/pagination', collection: @shows, base_path: shows_path, query: @query.presence %>
</section>
